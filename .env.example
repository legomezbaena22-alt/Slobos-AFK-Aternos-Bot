# Minecraft Java connection defaults. Environment variables override settings.json.
MC_HOST=BiggestWorld.aternos.me
MC_PORT=63406
MC_VERSION=26.3
MC_USERNAME=Manji
MC_AUTH=offline

# Optional: server plugin password for /login or /register (not Microsoft password).
# MC_AUTH_PASSWORD=

# On Railway, mount a persistent volume at /data and use:
MANJI_DATA_DIR=/data
# Optional explicit path for the persistent memory file:
# MANJI_MEMORY_FILE=/data/manji-memory.json
# Keep the process lock on the ephemeral application filesystem by default.
